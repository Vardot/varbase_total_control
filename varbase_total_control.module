<?php

/**
 * @file
 * Contains varbase_total_control.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\varbase_total_control\Hook\VarbaseTotalControlHooks;

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function varbase_total_control_page_attachments(array &$attachments) {
  \Drupal::service(VarbaseTotalControlHooks::class)->pageAttachments($attachments);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function varbase_total_control_theme($existing, $type, $theme, $path) {
  return \Drupal::service(VarbaseTotalControlHooks::class)->theme($existing, $type, $theme, $path);
}
